  "maskableIconUrl": "https://ajitov.github.io/nyxen/icons/icon-maskable-512.png",
  "appVersionName": "1.0.0",
  "appVersionCode": 1,
  "shortcuts": [
    {
      "name": "Battle Royale",
      "shortName": "Royale",
      "url": "/nyxen/index.html?mode=royale",
      "chosenIconUrl": "https://ajitov.github.io/nyxen/icons/icon-192.png"
    }
  ],
  "webManifestUrl": "https://ajitov.github.io/nyxen/manifest.json",
  "fallbackType": "customtabs",
