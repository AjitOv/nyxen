{
  "packageId": "io.github.ajitov.nyxen",
  "host": "ajitov.github.io",
  "name": "NYXEN — Underwater Ocean Simulation & Battle Royale",
  "launcherName": "NYXEN",
  "display": "fullscreen",
  "themeColor": "#0284c7",
  "themeColorDark": "#04121f",
